NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@host:5432/dbname
REDIS_URL=redis://host:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CREDENTIALS_ENC_KEY=replace-with-a-32-byte-random-string
CORS_ORIGIN=https://your-frontend.vercel.app

# Used to build links in verification/reset emails. Defaults to CORS_ORIGIN
# if unset.
FRONTEND_URL=https://your-frontend.vercel.app

# Email (forgot-password, email verification). Leave SMTP_HOST unset to run
# without a mail provider — emails are logged to the server console instead
# of sent, so the flows still work end to end during local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hotel CMS <no-reply@hotel-cms.local>"
